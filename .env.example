# Copier ce fichier en .env puis remplir les valeurs.
# .env n'est JAMAIS commité. Les vraies clés vont dans les secrets GitHub et Datacloud.

# --- Application ---
APP_ENV=development
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Nom affiché (en-tête, titre, manifest PWA)
PROJECT_NAME=MboaRec
BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

# --- Base de données (pilote asyncpg, pas psycopg) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# Délai maximal du SELECT 1 de /healthz, en secondes
DB_TIMEOUT_SECONDS=2

# --- MTN MoMo sandbox (API Collection) ---
# Obtenir la clé sur le portail développeur MTN MoMo (produit "Collection").
# API user + API key : créés via l'API sandbox (voir docs/). Ne jamais les commiter.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Devise et numéro de test : à confirmer dans la doc officielle MTN
MOMO_CURRENCY=EUR
MOMO_TEST_MSISDN=46733123455
SANDBOX_INTERVAL_MINUTES=60

# --- IA (couche ai_provider interchangeable) ---
# none = IA désactivée : doublons par trigram uniquement, adaptation indisponible
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_EMBEDDING_MODEL=
AI_CHAT_MODEL=
AI_TIMEOUT_SECONDS=15

# --- Limitation de débit ---
RATE_LIMIT_STORAGE_URI=memory://
